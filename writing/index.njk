---
title: "Writing"
layout: "base.njk"
description: "Essays, poems, reflections, and published writing by Pravan Omprakash."
pagination:
  data: collections.posts
  size: 10
  alias: posts
---

<section class="page-shell writing-page">
  <header class="page-intro">
    <p class="eyebrow">Writing</p>
    <h1>Notes from a mind that <em>wanders.</em></h1>
    <p>Essays, stories, poems, cricket, books, and the occasional attempt to make sense of things.</p>
  </header>

  {% if publications %}
  <section class="published-work" aria-labelledby="published-heading">
    <div class="section-heading">
      <p class="eyebrow">Elsewhere</p>
      <h2 id="published-heading">Published work</h2>
    </div>
    <div class="published-list">
      {% for item in publications | reverse %}
      <a href="{{ item.link }}" target="_blank" rel="noopener">
        <span><strong>{{ item.title }}</strong><small>{{ item.place }} · {{ item.date | date("MMMM d, yyyy") }}</small></span>
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="journal-section" aria-labelledby="journal-heading">
    <div class="section-heading">
      <p class="eyebrow">From the notebook</p>
      <h2 id="journal-heading">Journal</h2>
    </div>
    <div class="journal-grid">
      {% for post in posts | reverse %}
      <article class="journal-card">
        {% if post.data.image %}
        <a class="journal-image" href="{{ post.url | url }}" tabindex="-1">
          <img src="{{ post.data.image | url }}" alt="" loading="lazy">
        </a>
        {% endif %}
        <div class="journal-copy">
          <time datetime="{{ post.date | date('yyyy-MM-dd') }}">{{ post.date | date("MMMM d, yyyy") }}</time>
          <h3><a href="{{ post.url | url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.description }}</p>
          <a class="read-link" href="{{ post.url | url }}">Read the piece <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
</section>
