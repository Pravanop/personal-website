---
title: "Photography"
layout: "base.njk"
description: "Toy photography and scenes from the wider world by Pravan Omprakash."
---

<section class="page-shell gallery-page">
  <header class="page-intro">
    <p class="eyebrow">Through my lens</p>
    <h1>Small worlds and <em>wide horizons.</em></h1>
    <p>Toy stories made under a desk lamp, alongside moments gathered from the world outside.</p>
  </header>

  <div class="gallery-switcher" role="tablist" aria-label="Photography collection">
    <button class="is-active" type="button" role="tab" aria-selected="true" aria-controls="toyGallery" data-gallery="toyGallery">Micro <span>toy photography</span></button>
    <button type="button" role="tab" aria-selected="false" aria-controls="regularGallery" data-gallery="regularGallery">Macro <span>the wider world</span></button>
  </div>

  <section id="toyGallery" class="photo-section" role="tabpanel">
    <div class="masonry-grid">
      {% for photo in photography.toy %}
      <figure class="gallery-card">
        <button class="gallery-trigger" type="button" data-caption="{{ photo.title }} — {{ photo.caption }}">
          <img src="{{ photo.image | url }}" alt="{{ photo.title }}" loading="lazy">
        </button>
        <figcaption><strong>{{ photo.title }}</strong><span>{{ photo.caption }}</span><small>{{ photo.year }}</small></figcaption>
      </figure>
      {% endfor %}
    </div>
  </section>

  <section id="regularGallery" class="photo-section" role="tabpanel" hidden>
    <div class="masonry-grid">
      {% for photo in photography.regular %}
      <figure class="gallery-card">
        <button class="gallery-trigger" type="button" data-caption="{{ photo.title }} — {{ photo.caption }}">
          <img src="{{ photo.image | url }}" alt="{{ photo.title }}" loading="lazy">
        </button>
        <figcaption><strong>{{ photo.title }}</strong><span>{{ photo.caption }}</span><small>{{ photo.year }}</small></figcaption>
      </figure>
      {% endfor %}
    </div>
  </section>
</section>

<script>
  const galleryTabs = document.querySelectorAll('[data-gallery]');
  const galleryPanels = document.querySelectorAll('.photo-section');
  galleryTabs.forEach(tab => tab.addEventListener('click', () => {
    galleryTabs.forEach(item => {
      const active = item === tab;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-selected', active);
    });
    galleryPanels.forEach(panel => panel.hidden = panel.id !== tab.dataset.gallery);
  }));
</script>
